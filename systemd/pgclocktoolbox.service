[Unit]
Description=PGClockToolBox web panel
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pgclocktoolbox/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/pgclocktoolbox/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 6000
Restart=on-failure
RestartSec=3

NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/pgclocktoolbox /var/lib/pgclocktoolbox /opt/pasarguard /var/lib/pasarguard

[Install]
WantedBy=multi-user.target
